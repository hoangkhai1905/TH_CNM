<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Chi tiết sản phẩm</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen flex items-center justify-center p-4">
  <div class="bg-white rounded-lg shadow-xl overflow-hidden max-w-2xl w-full">
    <div class="md:flex">
      <div class="md:shrink-0 bg-gray-200 flex items-center justify-center">
        <% if (product.url_image) { %>
          <img class="h-64 w-full object-cover md:h-full md:w-64" src="<%= product.url_image %>" alt="<%= product.name %>">
        <% } else { %>
          <div class="h-64 w-full md:h-full md:w-64 flex items-center justify-center text-gray-400">No Image</div>
        <% } %>
      </div>
      <div class="p-8 w-full">
        <div class="uppercase tracking-wide text-sm text-indigo-500 font-semibold mb-1">ID: <%= product.productId %></div>
        <h1 class="block mt-1 text-2xl leading-tight font-bold text-gray-900"><%= product.name %></h1>
        
        <div class="mt-4 border-t border-gray-200 pt-4">
          <div class="grid grid-cols-2 gap-4">
            <div>
              <p class="text-sm text-gray-500">Giá sản phẩm</p>
              <p class="text-xl font-bold text-green-600 mt-1">$<%= product.price %></p>
            </div>
            <div>
              <p class="text-sm text-gray-500">Tồn kho</p>
              <p class="text-xl font-bold text-gray-800 mt-1"><%= product.unit_in_stock %></p>
            </div>
          </div>
        </div>

        <div class="mt-8 flex gap-3">
          <a href="/products/<%= product.productId %>/edit" class="bg-yellow-500 hover:bg-yellow-600 text-white font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline transition duration-150">
            Chỉnh sửa
          </a>
          <a href="/" class="bg-gray-500 hover:bg-gray-600 text-white font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline transition duration-150">
            Quay lại danh sách
          </a>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
